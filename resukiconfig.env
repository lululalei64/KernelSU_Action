CONFIG_ENV=resukiconfig.env

KERNEL_SOURCE=https://github.com/lululalei64/kernel_samsung_wingtech
KERNEL_SOURCE_BRANCH=resukisu
KERNEL_CONFIG=rsuntk-a04_defconfig
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=false

EXTRA_CMDS:LD=ld.lld LLVM=1 KCFLAGS='-DKERNEL_SU_VERSION=12800'

# Clang
## Custom
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

### if your set USE CUSTOM CLANG to false than DO NOT CHANGE CUSTOM CMDS
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

## AOSP
CLANG_BRANCH=android11-release
CLANG_VERSION=r383902

# GCC
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# ReSukiSU
ENABLE_RESUKISU=true
RESUKISU_TAG=v4.1.0
ENABLE_KPM=false
SUSFS_ENABLE=true
HIDE_STUFF=true

# Configuration
DISABLE-LTO=false
DISABLE_CC_WERROR=true
REMOVE_UNUSED_PACKAGES=false

# AnyKernel3
## AnyKernel3 Custom
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# Ccache
ENABLE_CCACHE=false

# DTBO image
NEED_DTBO=false

# Build boot images
BUILD_BOOT_IMG=true
SOURCE_BOOT_IMAGE=https://raw.githubusercontent.com/lululalei64/KernelSU_action/dev/boot/boot.img
